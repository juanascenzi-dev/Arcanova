# ─── REQUIRED IN PRODUCTION ──────────────────────────────────────────────────

# PostgreSQL connection string (from Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Admin panel password — CHANGE THIS in production, never use the default
ADMIN_PIN=change-this-in-production

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://australcancun.com,https://www.australcancun.com
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Port to listen on (Railway/Render set this automatically)
PORT=8080

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Node environment — set to "production" in prod
NODE_ENV=production

# ─── DEVELOPMENT ONLY ────────────────────────────────────────────────────────

# These are only needed locally — in production use the values above
# DATABASE_URL=postgresql://localhost:5432/austral_dev
# ADMIN_PIN=austral2025
# NODE_ENV=development
