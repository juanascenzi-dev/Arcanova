# ─── REQUIRED IN PRODUCTION (set in Vercel dashboard) ────────────────────────

# Full URL of the backend API server — NO trailing slash
# Example: https://austral-api.up.railway.app
VITE_API_URL=https://your-backend.up.railway.app

# ─── DEVELOPMENT ONLY ────────────────────────────────────────────────────────

# In development, Vite's proxy handles /api → localhost:8080
# so VITE_API_URL is NOT needed locally.

# Dev server port (set by Replit automatically)
# PORT=5173

# Base path for routing (set by Replit automatically)
# BASE_PATH=/
